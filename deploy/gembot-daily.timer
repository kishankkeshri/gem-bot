[Unit]
Description=Gem-bot daily run: 07:30 IST, a 13:30 retry, and 3 minutes after every boot

[Timer]
OnCalendar=*-*-* 07:30:00 Asia/Kolkata
# Retry slot: does nothing if the morning run already completed cleanly (run_daily.py --daily).
OnCalendar=*-*-* 13:30:00 Asia/Kolkata
# Pi switched on in the morning (or after a power cut): start once it has network and the right time.
OnBootSec=3min
Persistent=true
RandomizedDelaySec=1m

[Install]
WantedBy=timers.target
