# Gem-bot environment. Copy to .env and fill in. Never commit .env.

# ── Supabase ────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=
# "service_role" secret key. Server-side only; it bypasses row security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram (new bot from @BotFather) ─────────────────────
TELEGRAM_BOT_TOKEN=
# Your personal chat id (a number).
TELEGRAM_CHAT_ID=

# ── AI (optional) ───────────────────────────────────────────────────────────
# off    — static parsing only; fields it can't read show "not stated"
# gemini — static first, Gemini fills only the fields static parsing missed
AI_PROVIDER=gemini
# aistudio.google.com/api-keys — use its own AI Studio project so the
# free-tier daily quota isn't shared with other apps.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Behaviour ───────────────────────────────────────────────────────────────
HTTP_USER_AGENT="GemBot/0.1 (personal tender monitor)"
HTTP_MIN_DELAY_SECONDS=3
CLOSING_SOON_DAYS=3
# 1 = print the digest instead of sending it
DRY_RUN=1
